{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "onboarding": false,
  "requireConfig": "ignored",
  "autodiscover": false,
  "enabledManagers": ["custom.regex"],
  "dependencyDashboard": false,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^port/upstream\\.renovate$"],
      "matchStrings": [
        "termuxChromiumVersion\\s*=\\s*\"(?<currentValue>[0-9][0-9.]*)\""
      ],
      "depNameTemplate": "termux-chromium-upstream",
      "datasourceTemplate": "custom.termux-chromium",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<compatibility>\\d+)$"
    }
  ],
  "customDatasources": {
    "termux-chromium": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/termux/termux-packages/master/x11-packages/chromium/build.sh",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [ $map($filter($.releases, function($r){ $contains($r.version, "TERMUX_PKG_VERSION=") }), function($r){ {\"version\": $match($r.version, /TERMUX_PKG_VERSION=([0-9][0-9.]*)/).groups[0]} }) ] }"
      ]
    }
  },
  "packageRules": [
    {
      "matchDepNames": ["termux-chromium-upstream"],
      "enabled": true,
      "labels": ["upstream", "renovate"],
      "commitMessageTopic": "Termux upstream Chromium"
    }
  ]
}
